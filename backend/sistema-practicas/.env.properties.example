# Plantilla de configuracion local.
# Copiar este archivo como .env.properties (junto a build.gradle) y completar los valores.
# .env.properties NO se versiona; tambien pueden usarse variables de entorno del sistema.

DB_URL=jdbc:postgresql://host:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=valor_seguro
APP_JWT_SECRET=valor_seguro_largo_minimo_64_caracteres_hex
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200,https://tu-url.ngrok-free.app
app.auth.password-reset-minutes=30
APP_AUTH_LOGIN_MAX_ATTEMPTS=5
APP_AUTH_LOGIN_BLOCK_MINUTES=15
APP_AUTH_LOGIN_RATE_MAX_REQUESTS=30
APP_AUTH_LOGIN_RATE_WINDOW_SECONDS=60
# Activar solo si el backend queda detras de un proxy confiable que limpia X-Forwarded-For.
APP_AUTH_TRUST_FORWARDED_FOR=false

# Correo saliente SMTP (fase 13). Para desarrollo se recomienda Mailtrap.
# Dejar APP_MAIL_ENABLED=false si aun no se probara envio real.
APP_MAIL_ENABLED=false
APP_MAIL_FROM=no-reply@unibe.edu.ec
APP_MAIL_FROM_NAME=Sistema de Practicas y Vinculacion UNIBE
APP_MAIL_BASE_URL=http://localhost:4200
spring.mail.host=sandbox.smtp.mailtrap.io
spring.mail.port=2525
spring.mail.username=usuario_mailtrap
spring.mail.password=password_mailtrap
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

# Supabase Storage privado para documentos reales (fase 15).
# Para Storage usar Legacy API Keys > service_role (JWT) solo en backend/.env.properties.
# No usar publishable key; si una sb_secret devuelve RLS en Storage, usar service_role legacy.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service_role_jwt_privada
SUPABASE_STORAGE_BUCKET=documentos
SUPABASE_STORAGE_SIGNED_URL_SECONDS=300
APP_DOCUMENTOS_MAX_FILE_SIZE_BYTES=5242880
